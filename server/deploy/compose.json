{
  "name": "kiwi-duel",
  "services": {
    "app": {
      "build": {
        "context": "../..",
        "dockerfile": "server/deploy/Dockerfile",
        "args": { "NODE_IMAGE": "${NODE_IMAGE:-node:24-bookworm-slim}" }
      },
      "restart": "unless-stopped",
      "init": true,
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 256,
      "stop_grace_period": "30s",
      "tmpfs": ["/tmp:rw,noexec,nosuid,size=64m,mode=1777"],
      "ports": ["80:80/tcp", "443:443/tcp", "443:443/udp"],
      "environment": {
        "NODE_ENV": "production",
        "DUEL_PUBLIC_HOST": "${DUEL_PUBLIC_HOST:?Set your public DNS hostname}",
        "DUEL_SERVER_PUBLIC_BASE": "https://${DUEL_PUBLIC_HOST:?Set your public DNS hostname}",
        "DUEL_SERVER_HOST": "127.0.0.1",
        "DUEL_SERVER_PORT": "8080",
        "DUEL_GAME_SERVER_HOST": "127.0.0.1",
        "DUEL_GAME_SERVER_PORT": "8081",
        "DUEL_GAME_SERVER_PUBLIC_HOST": "${DUEL_PUBLIC_HOST:?Set your public DNS hostname}",
        "DUEL_ACCOUNT_DATABASE": "/var/lib/kiwi-duel/kiwi-duel.sqlite",
        "DUEL_BACKUP_DIRECTORY": "/var/backups/kiwi-duel",
        "DUEL_TRUSTED_PROXY_ADDRESSES": "127.0.0.1,::1,::ffff:127.0.0.1",
        "DUEL_DEFAULT_MATCH_MODE": "human",
        "DUEL_CHEST_UNLOCK_MS": "${DUEL_CHEST_UNLOCK_MS:?Choose an explicit owned-server chest timing policy}",
        "DUEL_GAME_BATTLE_EVIDENCE_MODE": "off",
        "DUEL_GAME_OPPONENT_PLATE_MODE": "off"
      },
      "volumes": ["accounts:/var/lib/kiwi-duel", "backups:/var/backups/kiwi-duel"]
    },
    "caddy": {
      "image": "${CADDY_IMAGE:-caddy:2-alpine}",
      "network_mode": "service:app",
      "depends_on": { "app": { "condition": "service_healthy", "restart": true } },
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": ["ALL"],
      "cap_add": ["NET_BIND_SERVICE"],
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "environment": { "DUEL_PUBLIC_HOST": "${DUEL_PUBLIC_HOST:?Set your public DNS hostname}" },
      "volumes": ["./Caddyfile:/etc/caddy/Caddyfile:ro", "caddy_data:/data", "caddy_config:/config"],
      "tmpfs": ["/tmp:rw,noexec,nosuid,size=32m,mode=1777"]
    }
  },
  "volumes": { "accounts": {}, "backups": {}, "caddy_data": {}, "caddy_config": {} }
}
